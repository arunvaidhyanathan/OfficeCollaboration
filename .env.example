# Copy this file to .env (same directory as docker-compose.yml) and fill in the values marked
# REQUIRED. Nothing here is committed with real secrets -- .env is gitignored.

# --- ONLYOFFICE <-> Document Core shared secret --------------------------------------------------
# REQUIRED. Any random string; used both to sign the editor config we hand to ONLYOFFICE and to
# verify the save-callback ONLYOFFICE sends back. Generate one with: openssl rand -base64 32
ONLYOFFICE_JWT_SECRET=

# --- Supabase Postgres (project ref nrhsoabqeskybrznxfyi) ----------------------------------------
# REQUIRED. From the Supabase dashboard: Settings > Database > Database password (the password you
# set when the project was created, or reset it there if you don't have it).
SPRING_DATASOURCE_PASSWORD=

# Optional overrides -- defaults in backend/src/main/resources/application.yml already point at the
# direct connection host. Uncomment and switch to the session-mode pooler if your network can't
# reach Supabase's direct host (no IPv6):
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres
# SPRING_DATASOURCE_USERNAME=postgres.nrhsoabqeskybrznxfyi

# Only needed if this Supabase project turns out to still be on the legacy HS256 shared-secret JWT
# scheme (the JWKS endpoint will 404 at runtime if so -- see SecurityConfig.java for the code swap
# this pairs with). From Supabase dashboard: Settings > API > JWT Settings > JWT Secret.
# SUPABASE_JWT_SECRET=

# --- S3 -------------------------------------------------------------------------------------------
# REQUIRED. Bucket must already exist; this app never creates one.
AWS_S3_BUCKET=
AWS_REGION=us-east-1
# Static credentials for local/dev use (the AWS SDK's default credential provider chain picks these
# up automatically). In a real deployment prefer an IAM role/instance profile instead and omit these.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
